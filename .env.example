BIND_ADDRESS=127.0.0.1

SEAWEEDFS_IMAGE=chrislusf/seaweedfs:latest
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.8

# --- SeaweedFS (S3) --------------------------------------------------------------
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_FILER_PORT=8888
S3_ACCESS_KEY=platform
S3_SECRET_KEY=change-me-s3-secret
# space-separated; "lake" is used by ClickHouse config
S3_BUCKETS=lake raw backups

# --- ClickHouse -------------------------------------------------------------------
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=change-me-clickhouse
CLICKHOUSE_DB=warehouse
